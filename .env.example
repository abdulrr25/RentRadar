ANAKIN_API_KEY=your_anakin_api_key_here

# Free LLM — sign up at console.groq.com (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here

# Server-to-server: Next.js route handler → FastAPI backend
# Local dev: http://localhost:8000
# Production: your deployed backend URL e.g. https://rentradar-api.onrender.com
BACKEND_API_URL=http://localhost:8000

# Required to enable POST /internal/run-alerts (saved-search matching worker).
# Leave unset to keep that endpoint disabled (returns 503).
ALERTS_INTERNAL_SECRET=

# ── Saved-search alert channels ──────────────────────────────────────────
# All three are optional and independently stubbed (logged instead of sent)
# until their env vars are set — see backend/channels/.

# Telegram — free, no business verification. Message @BotFather -> /newbot
# to get a token in ~2 minutes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Set when calling Telegram's setWebhook (secret_token param) — Telegram
# echoes it back on every webhook call so it can be verified here.
TELEGRAM_WEBHOOK_SECRET=

# Web Push — the only channel with zero external account. Generate a
# keypair with: python -m channels.webpush (from backend/), then copy
# VAPID_PUBLIC_KEY's value into the frontend's NEXT_PUBLIC_VAPID_PUBLIC_KEY too.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email via Resend — no GST/business verification needed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=RentRadar <onboarding@resend.dev>

# Frontend: used for absolute Open Graph URLs and robots.txt/sitemap.xml.
# Set to your real deployed domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Frontend: must match backend's VAPID_PUBLIC_KEY exactly — this one is not
# secret, it's handed to the browser's PushManager.subscribe() call.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
