ANAKIN_API_KEY=your_anakin_api_key_here

# Free LLM — sign up at console.groq.com (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here

# Saved-search alerts & shareable-brief storage. Leave both unset for local
# dev — defaults to a local SQLite file (backend/alerts.db) via libsql_client.
# In production, point these at a free Turso database (turso.tech — no GST,
# no card, no expiry) instead: Render's own disk is wiped on every redeploy.
#   DATABASE_URL=libsql://your-db-name.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Server-to-server: Next.js route handler → FastAPI backend
# Local dev: http://localhost:8000
# Production: your deployed backend URL e.g. https://rentradar-api.onrender.com
BACKEND_API_URL=http://localhost:8000

# Required to enable POST /internal/run-alerts (saved-search matching worker).
# Leave unset to keep that endpoint disabled (returns 503).
ALERTS_INTERNAL_SECRET=

# ── Saved-search alert channels ──────────────────────────────────────────
# All three are optional and independently stubbed (logged instead of sent)
# until their env vars are set — see backend/channels/.

# Telegram — free, no business verification. Message @BotFather -> /newbot
# to get a token in ~2 minutes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Set when calling Telegram's setWebhook (secret_token param) — Telegram
# echoes it back on every webhook call so it can be verified here.
TELEGRAM_WEBHOOK_SECRET=

# Web Push — the only channel with zero external account. Generate a
# keypair with: python -m channels.webpush (from backend/), then copy
# VAPID_PUBLIC_KEY's value into the frontend's NEXT_PUBLIC_VAPID_PUBLIC_KEY too.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email via Resend — no GST/business verification needed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=RentRadar <onboarding@resend.dev>

# Frontend: used for absolute Open Graph URLs and robots.txt/sitemap.xml.
# Set to your real deployed domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Frontend: must match backend's VAPID_PUBLIC_KEY exactly — this one is not
# secret, it's handed to the browser's PushManager.subscribe() call.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Error tracking ────────────────────────────────────────────────────────
# Uses the Sentry SDKs, but point them at GlitchTip (glitchtip.com) instead
# of Sentry itself — same ingestion protocol, but a genuinely permanent free
# tier (Sentry's is a 14-day trial). Leave unset to keep both backend and
# frontend running with no-op error tracking (nothing sent).
# Backend:
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Frontend (NEXT_PUBLIC_ — same DSN, just a client-visible copy; these DSNs
# are meant to be public, they only allow submitting events, not reading data):
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Only needed to enable build-time source map upload (nicer stack traces) —
# leave unset and the build still succeeds, just without that.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Product analytics ─────────────────────────────────────────────────────
# Umami (umami.is) — genuinely open-source (MIT), self-hostable for free,
# and its Cloud tier is a real permanent free plan (no card). No client SDK
# needed (a plain POST to /api/send), so this is zero bundle cost even when
# configured, not just when it isn't. Leave both unset to keep it a no-op.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_HOST=https://cloud.umami.is
