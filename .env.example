ANAKIN_API_KEY=your_anakin_api_key_here

# Free LLM — sign up at console.groq.com (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here

# Server-to-server: Next.js route handler → FastAPI backend
# Local dev: http://localhost:8000
# Production: your deployed backend URL e.g. https://rentradar-api.onrender.com
BACKEND_API_URL=http://localhost:8000

# Required to enable POST /internal/run-alerts (saved-search matching worker).
# Leave unset to keep that endpoint disabled (returns 503).
ALERTS_INTERNAL_SECRET=

# Set once a WhatsApp Business API account (e.g. AiSensy) exists — see
# backend/whatsapp.py. Until then, alerts are logged instead of sent.
AISENSY_API_KEY=
