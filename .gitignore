backend/local_test.db-shm

# Local SearXNG dev setup — run the engine from source without Docker
# (cloned repo, its own venv, a Windows pwd shim, and a generated settings
# file with a real secret). Local-only; production uses the Dockerfile.
searxng/src/
searxng/venv_sx/
searxng/winshim/
searxng/runtime_settings.yml

